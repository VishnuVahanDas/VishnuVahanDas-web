---
// A handwritten note in the margin, optionally with a hand-drawn arrow.
interface Props {
  color?: 'red' | 'blue';
  rotate?: number;
  arrow?: 'up' | 'left' | 'down' | 'none';
  class?: string;
}
const { color = 'red', rotate = -3, arrow = 'none', class: cls } = Astro.props;
const arrows = { up: '↑ ', left: '← ', down: '↓ ', none: '' };
---

<p class:list={['note', color, cls]} style={`--r:${rotate}deg`}>
  <span aria-hidden="true">{arrows[arrow]}</span>
  <slot />
</p>

<style>
  .note {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.3;
    transform: rotate(calc(var(--r) * var(--rot-scale)));
    display: inline-block;
  }
  .red {
    color: var(--ink-red);
  }
  .blue {
    color: var(--ink-blue);
  }
</style>
