---
// Rubber-stamp label, e.g. INCIDENT LOGGED / RESOLVED.
interface Props {
  text: string;
  color?: 'red' | 'blue';
  rotate?: number;
  size?: 'sm' | 'lg';
}
const { text, color, rotate = -4, size = 'sm' } = Astro.props;
const tone = color ?? (text === 'INCIDENT LOGGED' ? 'red' : 'blue');
---

<span class:list={['stamp', tone, size]} style={`--r:${rotate}deg`} data-reveal>
  {text}
</span>

<style>
  .stamp {
    display: inline-block;
    font-family: var(--font-type);
    letter-spacing: 0.18em;
    padding: 4px 10px;
    border: 2px solid currentColor;
    border-radius: 4px;
    opacity: 0.88;
    transform: rotate(var(--r));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .sm {
    font-size: 0.8125rem;
  }
  .lg {
    font-size: 1rem;
    padding: 6px 14px;
    border-width: 3px;
  }
  .red {
    color: var(--ink-red);
  }
  .blue {
    color: var(--ink-blue);
  }
</style>
