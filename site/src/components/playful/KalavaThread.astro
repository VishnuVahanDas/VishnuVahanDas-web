---
// A red-and-yellow sacred thread (kalava / mauli) tied across a section.
---

<div class="kalava" aria-hidden="true">
  <span class="knot"></span>
</div>

<style>
  .kalava {
    position: relative;
    height: 8px;
    margin: 0 calc(var(--page-pad) * -0.5);
    border-radius: 4px;
    background: repeating-linear-gradient(
      135deg,
      var(--kalava-red) 0 8px,
      var(--kalava-yellow) 8px 14px,
      var(--kalava-red) 14px 22px
    );
    transform: rotate(-0.6deg);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.15);
  }
  .knot {
    position: absolute;
    right: 18%;
    top: -6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, var(--kalava-yellow), var(--kalava-red) 70%);
  }
</style>
