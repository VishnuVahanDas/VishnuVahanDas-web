---
// Component kit: every token and component on one page, for development.
// Not linked anywhere, excluded from the sitemap and marked noindex.
import { getCollection, getEntry } from 'astro:content';
import NotebookLayout from '../layouts/NotebookLayout.astro';
import SectionTitle from '../components/notebook/SectionTitle.astro';
import MarginNote from '../components/notebook/MarginNote.astro';
import HandUnderline from '../components/notebook/HandUnderline.astro';
import Highlight from '../components/notebook/Highlight.astro';
import TapedPhoto from '../components/notebook/TapedPhoto.astro';
import Stamp from '../components/notebook/Stamp.astro';
import PilotCard from '../components/playful/PilotCard.astro';
import BoardingPass from '../components/playful/BoardingPass.astro';
import ManilaFolder from '../components/playful/ManilaFolder.astro';
import LuggageTag from '../components/playful/LuggageTag.astro';
import KalavaThread from '../components/playful/KalavaThread.astro';
import ArmSwitch from '../components/playful/ArmSwitch.astro';
import VentureCard from '../components/playful/VentureCard.astro';
import ReportHeaderForm from '../components/report/ReportHeaderForm.astro';
import ReportSection from '../components/report/ReportSection.astro';
import Prompt from '../components/report/Prompt.astro';
import NumbersGrid from '../components/report/NumbersGrid.astro';
import Signature from '../components/report/Signature.astro';
import SketchDiagram from '../components/report/SketchDiagram.astro';

const profile = (await getEntry('profile', 'vipul'))!.data;
const [report] = (await getCollection('reports')).sort((a, b) => a.data.order - b.data.order);

const swatches = [
  'desk',
  'paper',
  'paper-report',
  'card',
  'ink',
  'ink-muted',
  'ink-blue',
  'ink-red',
  'manila',
  'manila-edge',
  'tag',
  'photo-empty',
  'tab-1',
  'tab-2',
  'tab-3',
  'tab-4',
  'tab-5',
  'lipo',
  'tx-body',
  'armed',
  'kalava-red',
  'kalava-yellow',
];
---

<NotebookLayout title="Component kit" description="Design system reference." noindex>
  <SectionTitle level="h1" title="Component kit" sub="tokens and components, dev reference" />

  <h2 class="label">Colour tokens</h2>
  <ul class="sw">
    {swatches.map((s) => (
      <li>
        <span style={`background:var(--${s})`}></span>
        <code>--{s}</code>
      </li>
    ))}
  </ul>

  <h2 class="label">Type</h2>
  <p class="hand" style="font-size:3rem;color:var(--ink-blue)">
    Kalam: handwriting <span lang="hi">॥ श्री ॥</span>
  </p>
  <p class="type" style="font-size:1.25rem">
    Special Elite: typewriter labels
  </p>
  <p>
    Literata: body text for reading, with <em>italics</em> and <strong>bold</strong>.
  </p>

  <h2 class="label">Hand-made</h2>
  <div class="row">
    <div>
      <HandUnderline width={300} />
      <MarginNote arrow="up">a margin note in red</MarginNote>
    </div>
    <p>
      Some text with <Highlight>a highlighted phrase</Highlight>.
    </p>
    <Stamp text="INCIDENT LOGGED" />
    <Stamp text="RESOLVED" />
    <Stamp text="IN BUILD" size="lg" />
  </div>
  <div class="row">
    <TapedPhoto alt="placeholder" caption="a taped placeholder" rotate={-3} />
    <PilotCard profile={profile} />
    <BoardingPass href="/resume/" />
  </div>

  <h2 class="label">Playful</h2>
  <div class="row">
    {report && (
      <div style="width:320px">
        <ManilaFolder report={report} rotate={-1} />
      </div>
    )}
    <LuggageTag repo="nitya-dasa" rotate={-2} />
    <VentureCard name="HolyTrail" role="Founder" line="Yatra & pilgrimage journeys." />
  </div>
  <KalavaThread />
  <div style="max-width:460px;margin-top:32px">
    <ArmSwitch profile={profile} />
  </div>

  <h2 class="label">Report parts</h2>
  <ReportHeaderForm
    fields={[
      { k: 'Report no.', v: 'FR-00' },
      { k: 'Aircraft', v: 'Test frame' },
      { k: 'Date', v: '[date]' },
    ]}
  />
  <ReportSection no="03" title="Incident report" incident>
    <p>Body text.</p>
    <Prompt>a prompt for Vipul</Prompt>
  </ReportSection>
  <NumbersGrid
    numbers={[
      { label: 'Flight time', value: '12 min' },
      { label: 'Range', value: '[ ] m' },
    ]}
  />
  {report?.data.diagram && <SketchDiagram diagram={report.data.diagram} />}
  <Signature />
</NotebookLayout>

<style>
  h2.label {
    margin: 48px 0 16px;
    font-weight: 400;
  }
  .sw {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .sw li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
  }
  .sw span {
    width: 32px;
    height: 32px;
    border: 1px solid var(--ink);
    flex: none;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: flex-start;
    margin: 24px 0;
  }
</style>
