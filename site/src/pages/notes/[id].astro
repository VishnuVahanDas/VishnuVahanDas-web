---
import { getCollection, render } from 'astro:content';
import NotebookLayout from '../../layouts/NotebookLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => import.meta.env.DEV || !data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<NotebookLayout
  title={note.data.title}
  description={note.data.summary}
  paper="ruled"
  current="notes"
>
  <article class="note">
    <a class="hand back" href="/notes/">
      ← all field notes
    </a>
    <p class="label">{date}</p>
    <h1 class="hand">{note.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
</NotebookLayout>

<style>
  .note {
    max-width: 760px;
    margin: 0 auto;
  }
  .back {
    font-size: 1.25rem;
  }
  h1 {
    font-size: var(--fs-report);
    font-weight: 700;
    margin: 6px 0 24px;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1em;
  }
  .prose :global(h2) {
    font-family: var(--font-hand);
    font-size: 2rem;
    margin: 1.4em 0 0.4em;
  }
</style>
